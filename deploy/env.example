# Copy to /opt/shorty/.env on the VM and fill in. Never commit the real file.

# Database password (any long random string): openssl rand -base64 24
SHORTY_DB_PASSWORD=

# 32-byte key that encrypts the YouTube refresh token: openssl rand -base64 32
# Keep a backup: if it changes, the stored token can no longer be read (just reconnect YouTube).
SHORTY_ENCRYPTION_KEY=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application")
SHORTY_GOOGLE_CLIENT_ID=
SHORTY_GOOGLE_CLIENT_SECRET=
SHORTY_GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2/callback

# Host port and time zone of the container
SHORTY_PORT=8080
TZ=Europe/Berlin

